# ------------------------------------------------------------------
# Agentic CRM local profile. Append to docker/.env:
#   Get-Content crm-local\crm-local.env.example | Add-Content .env
# Values here override earlier duplicates only if they come LAST in .env.
# If .env already defines a key below, edit it there instead of duplicating.
# ------------------------------------------------------------------

# Vector store: separate pgvector container (settings in
# envs/vectorstores/pgvector.env.example; copy to pgvector.env to change them).
VECTOR_STORE=pgvector

LOG_LEVEL=INFO

# Public URLs. APP_WEB_URL builds the approval links shown to reviewers,
# so it must be reachable from wherever the approver's browser is.
# Local-only use: http://localhost. For LAN approvers use http://<your-LAN-IP>.
CONSOLE_API_URL=http://localhost
CONSOLE_WEB_URL=http://localhost
SERVICE_API_URL=http://localhost
APP_API_URL=http://localhost
APP_WEB_URL=http://localhost
FILES_URL=http://localhost
TRIGGER_URL=http://localhost
ENDPOINT_URL_TEMPLATE=http://localhost/e/{hook_id}

# SSRF proxy: allow Docker Desktop host + optional sidecars.
# Domain entries match hostnames used in Dify HTTP/MCP/tool calls.
# 192.168.65.0/24 is Docker Desktop's usual host range. Confirm with:
#   docker run --rm alpine getent hosts host.docker.internal
SSRF_PROXY_ALLOW_PRIVATE_DOMAINS=host.docker.internal,n8n,mcp-gateway
SSRF_PROXY_ALLOW_PRIVATE_IPS=192.168.65.0/24
# Slow local models: raise the HTTP Request / SSRF timeouts if calls to a
# local gateway time out (defaults are 5s).
SSRF_DEFAULT_TIME_OUT=30
SSRF_DEFAULT_READ_TIME_OUT=60

# Approval emails. Use Mailpit (compose profile "mail") for local testing:
# these go in docker/envs/core-services/shared.env (copy from .example),
# not .env, because that is where Dify reads mail settings:
#   MAIL_TYPE=smtp
#   MAIL_DEFAULT_SEND_FROM=dify@localhost
#   SMTP_SERVER=mailpit
#   SMTP_PORT=1025
#   SMTP_USE_TLS=false
#   SMTP_OPPORTUNISTIC_TLS=false
# Mailpit UI: http://localhost:8025

# Secrets: set your own values before first start.
# SECRET_KEY=<openssl rand -base64 42>
# DB_PASSWORD=<strong password>
# PGVECTOR_POSTGRES_PASSWORD=<strong password>  (and in envs/vectorstores/pgvector.env)
# N8N_ENCRYPTION_KEY=<random string, used by the n8n profile>
